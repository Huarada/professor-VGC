# ---- ProfessorVGC configuration (prefix: PROFESSORVGC_) ----
# Copy to .env and fill in the provider key you own.

# Orchestration backend: adk (Google Agent Development Kit, default) | langchain | native
PROFESSORVGC_ORCHESTRATOR=adk

# LLM (bring your own key). Defaults to Gemini (paired with ORCHESTRATOR=adk
# above and the Firestore-only Chaos backend below — a full Google-stack
# demo path); "openai" remains fully supported, just switch DEFAULT_PROVIDER
# back. PROFESSORVGC_GEMINI_MODEL is enforced at startup (Settings itself
# refuses to construct) to be Gemini 3.5 or newer — a competition
# requirement, not just a default; see src/config.py.
PROFESSORVGC_DEFAULT_PROVIDER=gemini
PROFESSORVGC_OPENAI_API_KEY=
PROFESSORVGC_OPENAI_MODEL=gpt-4o-mini
PROFESSORVGC_GEMINI_API_KEY=
PROFESSORVGC_GEMINI_MODEL=gemini-3.5-flash
PROFESSORVGC_LLM_TEMPERATURE=0.2
# Wall-clock ceiling per ADK agent turn (selection or explanation). A
# session's FIRST request pays one-time cold costs (this session's own
# Node calc/dex subprocesses spinning up, a fresh Firestore channel, a
# fresh ADK/genai client) that a long-running local dev process never
# pays — observed live to need more headroom on Cloud Run than locally.
PROFESSORVGC_AGENT_TIMEOUT_SECONDS=240

# Node damage-calc engine
PROFESSORVGC_NODE_BINARY=node
PROFESSORVGC_CALC_GEN=9
PROFESSORVGC_CALC_TIMEOUT_SECONDS=20

# Official Smogon data via @pkmn/smogon (analyses/sets/stats). Needs network at
# runtime. When true, strategies use official Smogon analyses (Chaos is fallback)
# and team-improvement questions use official sets + usage stats.
PROFESSORVGC_USE_SMOGON_DEX=true
PROFESSORVGC_SMOGON_DEX_TIMEOUT_SECONDS=30

# Semantic retrieval over official Smogon analysis prose (ranks passages
# against the user's actual question instead of always using the first
# available format's overview verbatim). Requires USE_SMOGON_DEX=true and
# network access for embeddings — reuses whichever provider key you already
# set above, no separate credential. See ADR-027.
PROFESSORVGC_USE_SEMANTIC_STRATEGY=false
PROFESSORVGC_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROFESSORVGC_GEMINI_EMBEDDING_MODEL=models/text-embedding-004
PROFESSORVGC_SEMANTIC_STRATEGY_TOP_K=3

# Data — Chaos usage stats. The app reads these UNCONDITIONALLY from Google
# Cloud Firestore — there is no local-file backend/config knob (a deliberate
# requirement, not a preference: see src/config.py's own comment). Needs
# FIRESTORE_PROJECT_ID below + a populated database — see DATA.md and
# scripts/migrate_chaos_to_firestore.py / scripts/sync_smogon_chaos_to_
# firestore.py, which populate Firestore FROM a local Chaos dump/from
# Smogon's own site respectively — that local-file reading is offline
# tooling for loading Firestore, a different concern from what the running
# app itself queries to answer a question.
PROFESSORVGC_REG_FALLBACK_DEPTH=3
PROFESSORVGC_CHAOS_TOP_N=3
PROFESSORVGC_FIRESTORE_PROJECT_ID=
PROFESSORVGC_FIRESTORE_DATABASE_ID=(default)
PROFESSORVGC_FIRESTORE_CHAOS_COLLECTION=chaos_tiers
# Path to a service account JSON key. Leave empty to use Application Default
# Credentials instead (gcloud auth application-default login, or an already-set
# GOOGLE_APPLICATION_CREDENTIALS env var) — never commit a real key file.
PROFESSORVGC_FIRESTORE_CREDENTIALS_PATH=
# Only needed if something on THIS machine TLS-intercepts outbound HTTPS with
# a locally-installed root cert (a security suite's "SSL scanning" feature, a
# corporate proxy, ...) — grpc has its own TLS stack, so pip-system-certs
# (which fixes this for openai/requests) does not cover it. See DATA.md's
# Firestore section for how to detect this and generate the bundle.
PROFESSORVGC_FIRESTORE_GRPC_CA_BUNDLE_PATH=
