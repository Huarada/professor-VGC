# React/FastAPI beta. The existing Dockerfile still deploys Streamlit.
FROM node:20-bookworm-slim AS node-build
WORKDIR /build
COPY docker/extra-ca-certs/ /tmp/extra-ca-certs/
COPY node_calc/package.json node_calc/package-lock.json node_calc/
COPY web/package.json web/package-lock.json web/
RUN bundle="$(find /tmp/extra-ca-certs -maxdepth 1 \( -name '*.pem' -o -name '*.crt' \) | head -n1)"; \
    if [ -n "$bundle" ]; then export NODE_EXTRA_CA_CERTS="$bundle"; fi; \
    cd node_calc && npm ci --omit=dev && cd ../web && npm ci
COPY web/index.html web/tsconfig.json web/vite.config.ts web/
COPY web/src/ web/src/
COPY web/public/ web/public/
RUN cd web && npm run build

FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app
COPY --from=node-build /usr/local/bin/node /usr/local/bin/node
COPY --from=node-build /build/node_calc/node_modules node_calc/node_modules
COPY --from=node-build /build/web/dist web/dist
COPY requirements.txt .
COPY docker/extra-ca-certs/ /tmp/extra-ca-certs/
RUN bundle="$(find /tmp/extra-ca-certs -maxdepth 1 \( -name '*.pem' -o -name '*.crt' \) | head -n1)"; \
    if [ -n "$bundle" ]; then export PIP_CERT="$bundle"; fi; \
    pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY node_calc/*.js node_calc/
COPY node_calc/src/ node_calc/src/
COPY pyproject.toml .
RUN useradd --create-home --uid 1000 appuser && mkdir -p /app/.cache/web \
    && chown -R appuser:appuser /app
USER appuser
ENV PYTHONPATH=/app PROFESSORVGC_NODE_BINARY=node
EXPOSE 8080
CMD uvicorn src.api.app:app --host 0.0.0.0 --port ${PORT:-8080}
